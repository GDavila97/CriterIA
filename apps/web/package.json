{
  "name": "criteria-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:docs": "prettier --write --config .prettierrc.json ../../docs ../../README.md ../../SECURITY.md",
    "format:docs:check": "prettier --check --config .prettierrc.json ../../docs ../../README.md ../../SECURITY.md",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "json2ts --input ../../services/api/contract/schema.json --output src/shared/api/types.gen.ts --unreachableDefinitions --unknownAny --maxItems=-1 --bannerComment=\"// Generated from services/api/contract/schema.json by pnpm gen:api; do not edit.\" && prettier --write --log-level=warn src/shared/api/types.gen.ts",
    "auth:migrate": "auth migrate --config src/shared/lib/auth/cli.ts --yes",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "node e2e/support/prepare.mjs && playwright test",
    "e2e:build": "NEXT_PUBLIC_APP_ENV=test NEXT_PUBLIC_API_URL=http://127.0.0.1:8090 NEXT_PUBLIC_OFFICE_VIEW=true next build",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "@sentry/nextjs": "11.10.0",
    "better-auth": "1.7.12",
    "next": "16.4.5",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "auth": "1.7.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.1",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
