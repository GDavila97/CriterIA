# CriterIA web. Copy to .env.local for local development; never commit real values.
# NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Runtime (F1)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080
# The office view arrives in F9; false hides the view switch.
NEXT_PUBLIC_OFFICE_VIEW=false
# Contact in "Privacidad y datos": an https profile page or a mailto: address. Empty uses GitHub.
NEXT_PUBLIC_CONTACT_URL=

# Observability (F1). Sentry stays off while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=

# Better Auth (F4). The secret signs sessions and encrypts the JWT private key: 32+ random
# characters, for example: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# web_role only sees the auth schema. Local value from services/api `make db-setup`.
AUTH_DATABASE_URL=postgresql://web_role:criteria-local@127.0.0.1:5432/criteria
# The API checks both claims (AUTH_ISSUER and AUTH_AUDIENCE there); empty means BETTER_AUTH_URL.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Email (F4, ADR 0020): none, smtp or resend. With none there is no verification and no
# password recovery, and the API must run with AUTH_REQUIRE_VERIFIED_EMAIL=false.
EMAIL_PROVIDER=none
EMAIL_FROM=
# Local Mailpit from services/api/docker-compose.yml: smtp://127.0.0.1:1025
SMTP_URL=
RESEND_API_KEY=

# Sign-in with GitHub (F4). OAuth App callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google is ready but has no button yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
