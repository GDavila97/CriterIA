# CriterIA web. Copy to .env.local for local development; never commit real values.
# Variables marked (F1) are validated at startup today; the rest are reserved for the phase noted.

# Runtime (F1)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8080

# Observability (F1). Sentry stays off while the DSN is empty.
NEXT_PUBLIC_SENTRY_DSN=

# Better Auth (F4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=

# Email delivery with Resend (F4)
RESEND_API_KEY=
EMAIL_FROM=
