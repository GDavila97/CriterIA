# Non-secret production settings for the API on Cloud Run, read from the deployed commit by
# scripts/deploy.sh. Secrets never go here: they come from Secret Manager. Plain KEY=value lines.

# Public origin of the web on Vercel (https, no trailing slash). It sets WEB_ORIGIN, AUTH_JWKS_URL,
# AUTH_ISSUER and AUTH_AUDIENCE, so the API trusts only the tokens and the CORS origin of that web.
WEB_URL=

APP_ENV=production
LOG_LEVEL=info
SENTRY_TRACES_SAMPLE_RATE=0.0

# Only Groq runs on the server key; Ollama stays out of production (no OLLAMA_BASE_URL).
SERVER_KEY_PROVIDERS=groq
# false while the web has EMAIL_PROVIDER=none (ADR 0020).
AUTH_REQUIRE_VERIFIED_EMAIL=false
CREDENTIALS_ACTIVE_KEY=1

USER_RUNS_PER_HOUR=5
USER_RUNS_PER_DAY=20
# 30 days of 0.10 USD add up to Groq's 3 USD monthly limit. A free run reserves about 0.0087 USD,
# so the dollar cap closes the free mode after 11 runs and the run cap matches it.
GLOBAL_DAILY_BUDGET_USD=0.10
GLOBAL_DAILY_RUNS=11
