# CriterIA API. Copy to .env for local development; never commit real values.
# The phase in parentheses says when each variable started being read.
# Empty values count as unset.

# Runtime (F1)
APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Observability (F1). Sentry stays off while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Default models for the CLI (F2). PROVIDER=ollama runs everything locally without keys.
# The judge (Evaluador) falls back to the generation provider and model when left empty.
PROVIDER=ollama
GENERATION_MODEL=llama3.1:8b
JUDGE_PROVIDER=
JUDGE_MODEL=

# Providers that may run on the keys below (comma-separated). Every other run needs the user's
# own key and is rejected with clave_requerida otherwise. Production sets only: groq
SERVER_KEY_PROVIDERS=groq,ollama
# Operator keys. Production holds only GROQ_API_KEY; OpenAI and Anthropic keys live only in a
# local .env for batch evaluation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Server-side Ollama; it may be a private address because only the operator sets it.
OLLAMA_BASE_URL=http://localhost:11434
PROVIDER_TIMEOUT_SECONDS=60
# Per-provider overrides (provider:seconds). Each call gets one retry only for connection errors or
# 5xx answers; never for 4xx or timeouts.
PROVIDER_TIMEOUTS=ollama:180
PROVIDER_MAX_RESPONSE_BYTES=1048576

# Graph and prompts (F2)
PROMPT_VERSION=v1
# The judge prompt has its own version and stays frozen while comparing agent versions.
JUDGE_VERSION=v1
MAX_REVIEW_ROUNDS=2
# Optional overrides; by default they point to services/api/prompts and config/models.toml.
PROMPTS_DIR=
MODELS_FILE=

# HTTP API (F3). The CLI does not need anything below; criteria-api refuses to start without
# DATABASE_URL, WEB_ORIGIN, AUTH_JWKS_URL, AUTH_ISSUER, AUTH_AUDIENCE, CREDENTIALS_KEYS and
# CREDENTIALS_ACTIVE_KEY.
# The only origin allowed by CORS (no credentials; Authorization travels as a header).
WEB_ORIGIN=http://localhost:3000
MAX_REQUEST_BYTES=65536

# Database (F3). The API connects as api_role; the migrations run as migrator_role.
# Local values match docker-compose.yml and `make db-setup`; never reuse them anywhere else.
DATABASE_URL=postgresql://api_role:criteria-local@127.0.0.1:5432/criteria
MIGRATION_DATABASE_URL=postgresql://migrator_role:criteria-local@127.0.0.1:5432/criteria
DATABASE_POOL_SIZE=10

# Auth (F3): short JWTs issued by the web (Better Auth), checked against its JWKS.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
# Asymmetric algorithms only (EdDSA, ES256, RS256...); HS* is rejected at startup.
AUTH_ALGORITHMS=EdDSA
# Claim that must be true for runs and keys; Better Auth puts it in the JWT payload.
AUTH_VERIFIED_CLAIM=email_verified
# false while the web cannot send verification emails (EMAIL_PROVIDER=none, ADR 0020).
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_JWKS_CACHE_SECONDS=300
AUTH_LEEWAY_SECONDS=30

# User keys encrypted with AES-256-GCM (F3). version:base64 of 32 random bytes, comma-separated;
# new keys are sealed with the active version and old versions stay readable during a rotation.
# Generate one with: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEYS=
CREDENTIALS_ACTIVE_KEY=1
CREDENTIAL_CHECKS_PER_HOUR=10

# Limits (F3). Per user, with or without their own key.
USER_RUNS_PER_HOUR=5
USER_RUNS_PER_DAY=20
# Daily cap for every run paid with server keys (ADR 0019).
GLOBAL_DAILY_RUNS=100
GLOBAL_DAILY_BUDGET_USD=1.0

# Runs and streaming (F3, ADR 0018)
RUN_TTL_MINUTES=60
SSE_HEARTBEAT_SECONDS=15

# End-to-end tests only (F4): deterministic models and key checks without any network.
# The API refuses to start with MODEL_BACKEND=fake unless APP_ENV=test.
MODEL_BACKEND=real
FAKE_MODEL_DELAY_MS=300
