# CriterIA API. Copy to .env for local development; never commit real values.
# Variables marked (F1) are read today; the rest are reserved for the phase noted.

# Runtime (F1)
APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Observability (F1). Sentry stays off while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Web origin allowed by CORS (F3)
WEB_ORIGIN=http://localhost:3000

# Database: Neon Postgres with api_role (F3)
DATABASE_URL=

# Auth: JWT issued by the web, validated with JWKS (F3)
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=criteria-api

# Providers (F2). PROVIDER=ollama runs everything locally without keys.
PROVIDER=ollama
GENERATION_MODEL=
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=
FALLBACK_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RESPONSE_BYTES=1048576

# Graph and prompts (F2)
PROMPT_VERSION=v1
MAX_REVIEW_ROUNDS=2
CHECKPOINT_TTL_MINUTES=60

# Usage limits (F3)
USER_RUNS_PER_HOUR=
USER_RUNS_PER_DAY=
GLOBAL_DAILY_BUDGET_USD=
