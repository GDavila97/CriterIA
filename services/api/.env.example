# CriterIA API. Copy to .env for local development; never commit real values.
# Variables marked (F1) or (F2) are read today; the rest are reserved for the phase noted.
# Empty values count as unset.

# Runtime (F1)
APP_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Observability (F1). Sentry stays off while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Default models for the CLI (F2). PROVIDER=ollama runs everything locally without keys.
# The judge (Evaluador) falls back to the generation provider and model when left empty.
PROVIDER=ollama
GENERATION_MODEL=qwen3:8b
JUDGE_PROVIDER=
JUDGE_MODEL=

# Providers that may run on the keys below (comma-separated). Every other run needs the user's
# own key and is rejected with clave_requerida otherwise. Production sets only: groq
SERVER_KEY_PROVIDERS=groq,ollama
# Operator keys. Production holds only GROQ_API_KEY; OpenAI and Anthropic keys live only in a
# local .env for batch evaluation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Server-side Ollama; it may be a private address because only the operator sets it.
OLLAMA_BASE_URL=http://localhost:11434
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RESPONSE_BYTES=1048576

# Graph and prompts (F2)
PROMPT_VERSION=v1
# The judge prompt has its own version and stays frozen while comparing agent versions.
JUDGE_VERSION=v1
MAX_REVIEW_ROUNDS=2
# Optional overrides; by default they point to services/api/prompts and config/models.toml.
PROMPTS_DIR=
MODELS_FILE=

# Web origin allowed by CORS (F3)
WEB_ORIGIN=http://localhost:3000

# Database: Neon Postgres with api_role (F3)
DATABASE_URL=

# Auth: JWT issued by the web, validated with JWKS (F3)
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=criteria-api

# Run limits (F3)
CHECKPOINT_TTL_MINUTES=60
USER_RUNS_PER_HOUR=
USER_RUNS_PER_DAY=
GLOBAL_DAILY_BUDGET_USD=
